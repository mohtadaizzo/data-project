POSTGRES_USER=eurogate
POSTGRES_PASSWORD=eurogate_secret
POSTGRES_DB=eurogate_risk
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Docker Compose (Postgres) — utilisé par le service backend :
DATABASE_URL=postgresql+psycopg2://eurogate:eurogate_secret@db:5432/eurogate_risk

# Développement local sans Docker — décommenter :
# DATABASE_URL=sqlite:///./eurogate_risk.db

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MODEL_PATH=/app/ai/artifacts/risk_model.joblib
PREPROCESSOR_PATH=/app/ai/artifacts/preprocessor.joblib
ENABLE_YOLO=false
SEED_ON_STARTUP=true

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/alerts
